{% extends 'base.html.twig' %}

{% block title %}Hello HomeController!{% endblock %}

{% block body %}
<div class="js">
    <div class="parallax">
        <section id="presentation">
            <h1>YugiDeck</h1>
            <h2>L'application pour gérer et partager tes deck !</h2>
            <p>recherchez, crée, et partager vos deck avec le monde entier !</p>
            <a href="{{ path('app_register') }}">INSRCIPTION</a>
        </section>
    </div>
<section class="deck-section">
        <h4>Les deck les plus récents</h4>
        <p>ils ont été fait par nos meilleurs utilisateurs !</p>
        <p><small>et sont là pour vous donner quelques idées...</small></p>
            <div id="homeListDeck">
                {% for deck in decks %}
                <div class="homeDeck">
                    <a href="{{ path('show_deck', {'id': deck.id}) }}">
                    <div class="imagedeck">
                        <div class="titredeck">
                            <h5>   
                                {{deck.title}}
                            </h5>
                        </div>
                        <img src="{{ asset ('imagesSite/deckbox.jpg') }}" class="background-image">
                        <img src="{{ asset ('imagesDeck/' ~ deck.picture ~ '.jpg') }}"class="foreground-image">
                        <div class="corpdeck">
                            <p>
                                crée par {{deck.user}}<br>
                                le {{deck.createdAt|date('d-m-Y')}}
                            </p>
                        </div>
                    </div>
                </a>
                </div>
                {% endfor %}
            </div>
</section>
<div class="parallax">
    <section class="card-section">
        <h4>Les cartes les plus jouées</h4>
        <p><small>Si elles sont jouées, c'est qu'elles sont fortes, non ?</small></p>
        <div id="homeListCard">
            {% for card in cards %}
            <div class="homeCard">
                <a class="imageCard" href="{{ path('show_card', {'id': card[0].refCard}) }}"><img src="{{ asset (card[0].picture) }}"></a>
            </div>
            {% endfor %}
        </div>
    </section>
</div>
 <section class="topic-section">
        <h4>List Topic les plus récents</h4>
        <article class="homeListTopic">
            {% for topic in topics %}
                <a href="{{ path('show_topic', {'topicId': topic.id}) }}">
                    <div class="topic-post">
                        <div class="author">
                            
                            <img src="{{ asset('assets/' ~ topic.user.picture) }}" alt="Avatar de {{ topic.user }}" class="foreground-image" height="50p"></br>
                            <p>Author : {{topic.user}} </br>
                            createBy : {{topic.createdAt|date("d-m-Y")}}</p>
                        </div>
                        
                            <div class="message">
                                <h5>{{topic.title}}</h5>
                            
                                <p>Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat. Duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore eu fugiat nulla pariatur. Excepteur sint occaecat cupidatat non proident, sunt in culpa qui officia deserunt mollit anim id est laborum.</p>
                            </div>
                        
                        
                    </div> 
                </a>
            {% endfor %}
        </article>
 </section>
 <div class="parallax">
    <section class="user-section">
        <h4>Listes de nos utilisateurs nos plus récents</h4>
        <div id="homeListUser">
            {% for user in users %}
            <div class="homeUser">
                <div class="imageUser">
                    
                        <div class="titreUser">
                            <h5>   
                                <a href="{{ path('show_user', {'id': user.id}) }}">{{user.username}}</a>
                            </h5>
                        </div>
                        
                            <img src="{{ asset ('imagesSite/cartevierge.png') }}" class="background-image">
                            <img src="{{ asset ('assets/' ~ user.picture) }}" alt="Avatar de {{ user.username }}" class="foreground-image" height="145p">
                             <div class="corpUser">

                             </div>   
                    
                </div>
            </div>
            {% endfor %}
        </div>
    </section>
</div>

 <button type="button" id="scrollToTopBtn" class="hidden">Haut de page</button>  

</div>
{% endblock %}
