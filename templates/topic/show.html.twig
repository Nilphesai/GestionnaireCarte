{% extends 'base.html.twig' %}

{% block title %}Hello TopicController!{% endblock %}

{% block body %}
<div class="js-filter">
    <article class="homeListTopic">
    {% for post in posts %}
    <div class="post">
        <div class="author">
            <img src="https://picsum.photos/50"></br>
            <p>écrit le {{post.createdAt|date("d-m-Y")}}</br>
            par {{post.user}}</p>
            {% if is_granted("ROLE_ADMIN") %}
            <p class="deleteButton"><a href="{{ path('delete_post', {'postId': post.id}) }}">Delete</a></p>
            {% endif %}
        </div>
        <div class="message">
        <p>{{post.text|nl2br}}</p>
        
        </div>
    </div>
    {% endfor %}
    </article>
    {% if app.user %}
    <div id="card-search-filter" style="display:none;">
        <div class="formPost">
            {{ form_start(formPost, {'action': path('new_post')} ) }}
            {{ form_row(formPost.text)}}
            <div class="hidden">
                {{ form_row(formPost.createdAt)}}
                {{ form_row(formPost.user)}}
                {{ form_row(formPost.topic)}}
            </div>

            {{ form_end(formPost) }}
        </div>
    </div>
    <button type="button" id="openFormSearch">nouveau post</button>
    {% endif %}    
</div>

{% endblock %}
