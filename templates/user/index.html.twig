{% extends 'base.html.twig' %}

{% block title %}Hello UserController!{% endblock %}

{% block body %}
<div id="page">
    <div id="page-user">

        <div id="image-user">
            <img src="{{ asset('assets/' ~ app.user.picture) }}" alt="Avatar de {{ app.user.username }}">
            <form action="{{ path('update_avatar', {'id': app.user.id}) }}" method="post" enctype="multipart/form-data">
                <input type="file" name="avatar">
                <input type="hidden" name="_token" value="{{ csrf_token('unique_identifier') }}">
                        <button type="submit">
                            <i>modify</i>
                        </button>
            </form>
        </div>

        <div id="username-user">
            <h1>{{app.user.username}}</h1>

            <form action="{{ path('update_username') }}" method="post">
                <input type="hidden" name="_token" value="{{ csrf_token('unique_identifier') }}">
                <input name="username" value="{{ app.user.username }}">
                            <button type="submit">
                                <i>modify</i>
                            </button>
            </form>
        </div>

        <div id="email-user">
            <h6>{{app.user.email}}</h6>
            <form action="{{ path('update_email') }}" method="post">
                <button type="submit">
                    <i>modify</i>
                </button>
                <input name="email" value="{{ app.user.email }}">
                <input type="hidden" name="_token" value="{{ csrf_token('unique_identifier') }}">
            </form>
        </div>

        <div id="password-user">

            <form action="{{ path('update_password') }}" method="post">
                <button type="submit">
                    <i>modify</i>
                </button>
                <input name="password" value=""pattern="(?=.*[A-Z])(?=.*\d)(?=.*[@$!%*?&])[A-Za-z\d@$!%*?&]{12,}" 
                title="Le mot de passe doit contenir au moins une majuscule, un chiffre, un caractère spécial et être d'au moins 12 caractères.">
                <input type="hidden" name="_token" value="{{ csrf_token('unique_identifier') }}">
            </form>
        </div>

        <a href="{{ path('app_deckUser', {'id': app.user.id}) }}"> Mes Deck</a>
        <a href="{{ path('app_topic', {'id': app.user.id}) }}"> Mes Topic</a>
        <div class="supprimer"><a href="{{ path('delete_user', {'userId': app.user.id}) }}">Supprimer le compte</a></div>
    </div>
</div>
{% endblock %}